{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitHub Issue Widget",
  "version": "0.1.0",
  "identifier": "com.githubissuewidget.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitHub Issue Widget",
        "width": 900,
        "height": 520,
        "minWidth": 600,
        "minHeight": 300,
        "center": true,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false
  }
}
